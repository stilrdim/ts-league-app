{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run TS Debug",
      "program": "${workspaceFolder}/src/league.ts", // entry point
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "tsc: build - tsconfig.json", // optional
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}
